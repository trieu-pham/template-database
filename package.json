{
  "name": "tremor-database-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.3",
    "@payloadcms/db-mongodb": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.6.0",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^17.0.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "payload": "^3.90.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-wrap-balancer": "^1.1.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.9",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^1.29.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.4",
      "@types/react-dom": "19.0.2"
    }
  }
}
